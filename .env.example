# Ollama Local LLM Configuration
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
DEFAULT_CREATIVE_MODEL=llama3
DEFAULT_LOGIC_MODEL=deepseek-coder:6.7b

# Cloud Fallback (Optional Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
FORCE_GEMINI=0
TURBO_MODE=0

# Scoring Weights & Thresholds
SIMILARITY_THRESHOLD=0.65
EVIDENCE_THRESHOLD=0.70
MIN_EVIDENCE_COUNT=3
MAX_CORRECTION_ITERATIONS=3

WEIGHT_NOVELTY=0.35
WEIGHT_FEASIBILITY=0.25
WEIGHT_IMPACT=0.25
WEIGHT_EVIDENCE=0.15

# Simulation & Output Paths
SIMULATION_SAMPLE_SIZE=100
DB_PATH=ctsd_memory.db
OUTPUT_DIR=research_output
